# MOSI PLAN – Konfiguration (install.sh erzeugt .env automatisch; niemals committen)
POSTGRES_PASSWORD=bitte-durch-install.sh-erzeugen
SECRET_KEY=bitte-durch-install.sh-erzeugen

# Öffentliche Adresse (für OAuth-Redirect und Links). HTTPS empfohlen/erforderlich für Mikrofon & PWA.
PUBLIC_URL=https://planer.example.de
SERVER_NAME=planer.example.de
SERVER_IP=
# off | selfsigned | custom   (custom: Zertifikate nach data/certs/fullchain.pem + privkey.pem)
TLS_MODE=selfsigned
HTTP_PORT=80
HTTPS_PORT=443
COOKIE_SECURE=true

# Hermes Agent (optional, aber empfohlen). COMPOSE_PROFILES=hermes startet den Hermes-Container.
COMPOSE_PROFILES=hermes
HERMES_ENABLED=true
HERMES_IMAGE=nousresearch/hermes-agent:stable
HERMES_API_KEY=bitte-durch-install.sh-erzeugen
MCP_TOKEN=bitte-durch-install.sh-erzeugen

# Optional: direkter OpenAI-kompatibler KI-Anbieter (Fallback / ohne Hermes). Auch in den Einstellungen änderbar.
AI_DIRECT_BASE_URL=
AI_DIRECT_MODEL=
AI_DIRECT_API_KEY=

# Optional: Google OAuth (alternativ in den Einstellungen eintragen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_LIMIT_GB=30
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
